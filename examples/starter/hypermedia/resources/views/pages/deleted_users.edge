@layouts.app({ title: 'Deleted accounts' })
  @page()
    <h1>Deleted accounts</h1>
    @if(users.length === 0)
      <p>
        {{ currentPage === 1 ? 'No account is deleted.' : 'No deleted accounts on this page.' }}
      </p>
    @else
      <ul>
        @each(user in users)
          <li>
            {{ user.email }}, deleted {{ user.deletedAt }}
            @form({
              route: 'deleted_users.restore',
              routeParams: { id: user.id },
              method: 'POST',
            })
              @!button({ text: `Restore ${user.email}`, type: 'submit' })
            @end
          </li>
        @end
      </ul>
    @end
    @if(currentPage > 1 || currentPage < lastPage)
      <nav aria-label="Deleted accounts pages">
        @if(currentPage > 1)
          <a href="?page=1">First page</a>
          <a href="?page={{ currentPage - 1 }}">Previous page</a>
        @end
        @if(currentPage < lastPage)
          <a href="?page={{ currentPage + 1 }}">Next page</a>
        @end
      </nav>
    @end
  @end
@end
