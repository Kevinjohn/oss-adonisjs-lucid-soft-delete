TZ=UTC
PORT=3333
HOST=localhost
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_CLIENT=better-sqlite3
DB_DATABASE=./database.sqlite3

# For PostgreSQL, set DB_CLIENT=pg and supply these values.
