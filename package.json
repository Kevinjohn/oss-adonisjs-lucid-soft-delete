{
  "name": "@kevinjohn/adonisjs-lucid-soft-delete",
  "description": "Soft deletes for AdonisJS 7 Lucid models",
  "version": "0.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "README-AGENTS.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types/index.js",
    "./types/*": "./build/src/types/*.js",
    "./bindings": "./build/src/bindings/model_query_builder.js",
    "./lucid_soft_delete_provider": "./build/providers/lucid_soft_delete_provider.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "test:built-exports": "cross-env TEST_BUILT_EXPORTS=1 pnpm quick:test --files=declarations.spec.ts,package_exports.spec.ts",
    "test:consumer": "node --import=@poppinss/ts-exec --enable-source-maps bin/test_consumer.ts",
    "test:pg": "bash bin/pg.sh test",
    "pg:start": "bash bin/pg.sh start",
    "pg:stop": "bash bin/pg.sh stop",
    "test:mysql": "cross-env DB_CLIENT=mysql2 pnpm quick:test",
    "check": "node --import=@poppinss/ts-exec --enable-source-maps bin/check.ts",
    "check:changed": "node --import=@poppinss/ts-exec --enable-source-maps bin/check_changed.ts",
    "precompile": "pnpm lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "pnpm compile",
    "docs:check": "node --import=@poppinss/ts-exec --enable-source-maps bin/docs_check.ts",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "bin/**"
    ],
    "check-coverage": true,
    "statements": 100,
    "lines": 100,
    "branches": 95,
    "functions": 100
  },
  "keywords": [
    "adonisjs",
    "adonisjs-lucid",
    "adonisjs-soft-deletes",
    "adonis",
    "adonis-lucid",
    "adonis-soft-deletes"
  ],
  "author": "Kevinjohn Gallagher",
  "license": "MIT",
  "homepage": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete#readme",
  "bugs": {
    "url": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete.git"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "luxon": "^3.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "luxon": "^3.4.4",
    "typescript": "^5.9.3 || ^6.0.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./src/types/index.ts",
      "./src/types/querybuilder.ts",
      "./src/bindings/model_query_builder.ts",
      "./providers/lucid_soft_delete_provider.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@11.23.0"
}
