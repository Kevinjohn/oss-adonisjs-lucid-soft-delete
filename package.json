{
  "name": "@kevinjohn/lucid-soft-deletes",
  "description": "Soft deletes for AdonisJS 7 Lucid models",
  "version": "0.1.1-alpha",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "main": "./build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types/*": "./build/src/types/*.js",
    "./bindings": "./build/src/bindings/model_query_builder.js",
    "./provider": "./build/providers/lucid_soft_deletes_provider.js"
  },
  "scripts": {
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm build",
    "test": "c8 pnpm quick:test",
    "test:consumer": "node scripts/test_packed_consumer.mjs",
    "check:changed": "node --import=@poppinss/ts-exec --enable-source-maps bin/check_changed.ts",
    "precompile": "pnpm lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "pnpm compile",
    "prepublishOnly": "pnpm build",
    "version": "pnpm build",
    "docs:check": "node --import=@poppinss/ts-exec --enable-source-maps bin/docs_check.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.0.0",
    "@types/node": "^25.3.5",
    "better-sqlite3": "^12.0.0",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "luxon": "^3.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "luxon": "^3.4.4"
  },
  "author": "Kevinjohn Gallagher",
  "license": "MIT",
  "homepage": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete.git"
  },
  "bugs": {
    "url": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete/issues"
  },
  "keywords": [
    "adonisjs",
    "adonisjs-lucid",
    "adonisjs-lucid-soft-deletes",
    "adonisjs-soft-deletes",
    "adonis",
    "adonis-lucid",
    "adonis-lucid-soft-deletes",
    "adonis-soft-deletes"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "packageManager": "pnpm@11.23.0",
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./src/types/querybuilder.ts",
      "./src/bindings/model_query_builder.ts",
      "./providers/lucid_soft_deletes_provider.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  }
}
